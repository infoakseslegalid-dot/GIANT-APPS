# ═══════════════════════════════════════════════════════════════════════
#  GIANT-APPS — contoh environment. Salin jadi `.env` lalu isi nilainya.
#      cp .env.example .env          (Git Bash / Linux / macOS)
#      Copy-Item .env.example .env   (PowerShell)
#  File `.env` TIDAK ikut ter-commit (lihat .gitignore).
#
#  Dipakai untuk dev DAN untuk deploy produksi di VPS. Di produksi, hanya
#  DATABASE_URL, DIRECT_URL, dan JWT_SECRET yang dibaca dari sini — domain,
#  NODE_ENV, PORT, dan COOKIE_SECURE sudah dipatok di docker-compose.prod.yml.
# ═══════════════════════════════════════════════════════════════════════

# ─── Database: Supabase ────────────────────────────────────────────────
# Ambil di Supabase Dashboard → Connect (tombol di header) → ORMs / Prisma,
# atau Project Settings → Database → Connection string.
#
# Catatan penting:
#   • Ganti [YOUR-PASSWORD] dengan password database (bukan password akun).
#   • Kalau password mengandung karakter spesial (@ : / ? # & %), URL-encode
#     dulu. Contoh: "p@ss:w0rd" → "p%40ss%3Aw0rd".
#   • Bungkus dengan tanda kutip supaya karakter spesial aman dibaca.
#
# DATABASE_URL — dipakai Prisma Client saat aplikasi jalan.
# Pakai "Session pooler" (port 5432): koneksi persisten, semua fitur Postgres
# aktif, dan ramah IPv4 (jaringan rumah/kantor umumnya belum IPv6).
DATABASE_URL="postgresql://postgres.abcdefghijklmnopqrst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# DIRECT_URL — dipakai Prisma untuk `db push` / `migrate` / introspeksi.
# Boleh sama persis dengan DATABASE_URL kalau memakai Session pooler di atas.
DIRECT_URL="postgresql://postgres.abcdefghijklmnopqrst:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Alternatif — "Transaction pooler" (port 6543) untuk DATABASE_URL. Kalau
# dipakai, WAJIB tambahkan ?pgbouncer=true dan DIRECT_URL harus tetap port 5432:
# DATABASE_URL="postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Auth ──────────────────────────────────────────────────────────────
# Kunci penanda-tangan JWT. WAJIB diganti — kalau kosong kode jatuh ke
# "default_secret" (lihat src/server/deps.ts:28). Bikin nilai acak:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Cookie Secure=true hanya untuk HTTPS. Di dev (http://localhost) biarkan false,
# kalau true browser akan menolak menyimpan cookie login. Stack produksi
# mengabaikan nilai ini dan selalu memakai true.
COOKIE_SECURE="false"

# ─── Server ────────────────────────────────────────────────────────────
PORT="3000"
HOSTNAME="0.0.0.0"
NODE_ENV="development"

# ─── Opsional: object storage (Emergent) ───────────────────────────────
# Kosongkan saja untuk dev — upload lampiran otomatis jatuh ke folder lokal
# ./local_storage (lihat src/server/storage.ts).
# EMERGENT_LLM_KEY=""
# INTEGRATION_PROXY_URL=""
