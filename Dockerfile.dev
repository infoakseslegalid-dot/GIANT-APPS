# ══════════════════════════════════════════════════════════════════════
#  Image untuk DEVELOPMENT (hot reload). Bukan untuk produksi.
#  Source code di-bind-mount dari host lewat docker-compose.dev.yml,
#  jadi image ini isinya cuma toolchain + node_modules + Prisma Client.
# ══════════════════════════════════════════════════════════════════════
FROM node:22-bookworm-slim

# openssl: dibutuhkan query engine Prisma di image -slim.
# ca-certificates: TLS ke Supabase.
RUN apt-get update \
 && apt-get install -y --no-install-recommends openssl ca-certificates \
 && rm -rf /var/lib/apt/lists/*

# package.json memakai "packageManager": "yarn@1.22.22" → dipasang via corepack.
# Prompt unduhan dimatikan supaya build tidak menggantung menunggu jawaban.
ENV COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    NEXT_TELEMETRY_DISABLED=1
RUN corepack enable

WORKDIR /app

# Dependency di-copy duluan supaya layer install ter-cache selama lockfile
# belum berubah.
COPY package.json yarn.lock ./
RUN yarn install --frozen-lockfile --non-interactive

# Prisma Client digenerate saat build. node_modules hidup di named volume
# (lihat compose), jadi hasil generate ikut terbawa ke volume saat pertama
# kali dibuat.
COPY prisma ./prisma
RUN yarn prisma generate

COPY docker/dev-entrypoint.sh /usr/local/bin/dev-entrypoint.sh
RUN chmod +x /usr/local/bin/dev-entrypoint.sh

EXPOSE 3000

ENTRYPOINT ["dev-entrypoint.sh"]
CMD ["yarn", "dev"]
