generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum DistributionStatus {
  AVAILABLE
  CLAIMED
  DIRECT_ASSIGNED
  RELEASED
}

enum AssignmentAction {
  CLAIM
  UNCLAIM
  DIRECT_ASSIGN
  TAKE_OVER
  REASSIGN
}

// Bank Data & Distribusi Pekerjaan (PRD v1.0):
// Master Card dimiliki oleh CS (Owner). 1 Master Card -> banyak Assignment (WorkItem).
// Master Card TIDAK diduplikasi saat pekerjaan dikirim ke divisi lain.
model MasterCard {
  id              String   @id @default(uuid())
  title           String
  client          String?
  // owner null selama client offline belum di-claim CS (Flow B)
  ownerUserId     String?
  ownerDivisionId String?
  // Single source of truth untuk label seluruh grup (rep + semua assignment).
  // Bentuk: [{ name: string, color: string }]. Setiap WorkItem di grup
  // disinkronkan ke daftar ini (label per-board di-mirror by name).
  sharedLabels    Json     @default("[]")

  // Harga yang diberikan ke klien untuk keseluruhan job (Rupiah).
  price        Int?
  priceNote    String?
  priceSetById String?
  priceSetAt   DateTime?

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  owner         User?      @relation("MasterCardOwner", fields: [ownerUserId], references: [id])
  ownerDivision Division?  @relation("MasterCardOwnerDivision", fields: [ownerDivisionId], references: [id])
  assignments   WorkItem[]
  payments      Payment[]

  @@index([ownerUserId])
}

// Satu baris = satu pembayaran masuk untuk sebuah job (MasterCard).
// Status bayar diturunkan: sum(amount) vs MasterCard.price → Belum / DP / Lunas.
model Payment {
  id             String   @id @default(uuid())
  masterCardId   String
  amount         Int // Rupiah, selalu positif
  kind           String   @default("dp") // "dp" | "pelunasan" | "full"
  method         String? // transfer / tunai / dll (teks bebas)
  note           String?
  paidAt         DateTime @default(now())
  // Snapshot atribusi performa saat dicatat (biasanya CS PIC / owner job).
  picUserId      String?
  picDivisionId  String?
  recordedById   String
  recordedByName String?
  createdAt      DateTime @default(now())

  masterCard MasterCard @relation(fields: [masterCardId], references: [id], onDelete: Cascade)

  @@index([masterCardId])
  @@index([paidAt])
  @@index([picUserId])
}

model Division {
  id        String   @id @default(uuid())
  name      String
  color     String?
  key       String   @unique
  createdAt DateTime @default(now())

  users            User[]
  boards           Board[]
  workItems        WorkItemDivision[]
  targetWorkItems  WorkItem[]         @relation("TargetDivision")
  masterCardsOwned MasterCard[]       @relation("MasterCardOwnerDivision")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         String   @default("viewer")
  divisionId   String?
  avatarColor  String?
  isActive     Boolean  @default(true)
  theme        String   @default("system") // light | dark | system
  locale       String   @default("id") // id | en
  createdAt    DateTime @default(now())

  division           Division?      @relation(fields: [divisionId], references: [id])
  boardsCreated      Board[]        @relation("BoardCreator")
  workItemsCreated   WorkItem[]     @relation("WorkItemCreator")
  workItemsSubmitted WorkItem[]     @relation("WorkItemSubmitter")
  workItemsApproved  WorkItem[]     @relation("WorkItemApprover")
  activities         Activity[]
  comments           Comment[]
  notifications      Notification[]
  attachments        Attachment[]

  boardMembers    BoardMember[]
  workItemMembers WorkItemMember[]

  picWorkItems             WorkItem[]                  @relation("CurrentPic")
  sourcedWorkItems         WorkItem[]                  @relation("WorkItemSource")
  masterCardsOwned         MasterCard[]                @relation("MasterCardOwner")
  assignmentHistoryFrom    WorkItemAssignmentHistory[] @relation("AssignmentFrom")
  assignmentHistoryTo      WorkItemAssignmentHistory[] @relation("AssignmentTo")
  assignmentHistoryCreated WorkItemAssignmentHistory[] @relation("AssignmentCreated")
}

model Board {
  id          String   @id @default(uuid())
  name        String
  divisionId  String?
  background  String? // warna solid (fallback / dipakai bila tidak ada gambar)
  backgroundImagePath String? // path di object storage untuk gambar latar custom
  backgroundImageType String? // content-type gambar latar
  isArchived  Boolean  @default(false)
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt

  division  Division? @relation(fields: [divisionId], references: [id])
  createdBy User      @relation("BoardCreator", fields: [createdById], references: [id])

  members           BoardMember[]
  lists             List[]
  labels            Label[]
  workItems         WorkItem[]
  mirroredWorkItems WorkItemMirror[]
  automationRules   AutomationRule[]
  activities        Activity[]
  notifications     Notification[]

  sourceWorkItems WorkItem[] @relation("SourceBoard")
  targetWorkItems WorkItem[] @relation("TargetBoard")
}

model BoardMember {
  boardId String
  userId  String
  board   Board  @relation(fields: [boardId], references: [id])
  user    User   @relation(fields: [userId], references: [id])

  @@id([boardId, userId])
}

model List {
  id                String    @id @default(uuid())
  boardId           String
  name              String
  color             String?
  position          Float
  entryRequirements Json? // Array of strings
  archived          Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())

  board           Board            @relation(fields: [boardId], references: [id], onDelete: Cascade)
  workItems       WorkItem[]
  automationRules AutomationRule[]

  sourceWorkItems WorkItem[] @relation("SourceList")
  targetWorkItems WorkItem[] @relation("TargetList")
}

model Label {
  id        String   @id @default(uuid())
  boardId   String
  name      String
  color     String?
  createdAt DateTime @default(now())

  board     Board           @relation(fields: [boardId], references: [id], onDelete: Cascade)
  workItems WorkItemLabel[]
}

model WorkItem {
  id            String  @id @default(uuid())
  title         String
  clientName    String?
  description   String?
  boardId       String
  listId        String
  position      Float
  startDate     String? // format YYYY-MM-DD
  dueDate       String? // format YYYY-MM-DD
  priority      String  @default("none")
  status        String  @default("active")
  archived      Boolean @default(false)
  needsApproval Boolean @default(false)

  createdById   String
  createdByName String?
  submittedById String?
  approvedById  String?

  hariStage     Int?
  hariEnteredAt DateTime?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())
  completedAt DateTime?

  // Bank Data & Distribution Fields
  masterCardId       String? // null = kartu biasa / Master Card itu sendiri
  sourceUserId       String? // user pengirim (Kirim ke Divisi)
  sourceBoardId      String?
  sourceListId       String?
  targetDivisionId   String?
  targetBoardId      String?
  targetListId       String?
  currentPicId       String?
  distributionStatus DistributionStatus @default(AVAILABLE) // AVAILABLE = menunggu diambil
  workStatus         String? // progress: WAITING_CLAIM|CLAIMED|IN_PROGRESS|WAITING|REVISION|COMPLETED|CANCELLED
  claimedAt          DateTime?
  releasedAt         DateTime?

  checklists Json? // Complex JSON structure for checklists

  coverColor        String?
  coverAttachmentId String?
  watcherUserIds    String[] @default([]) // user yang "menonton" kartu ini

  board       Board @relation(fields: [boardId], references: [id])
  list        List  @relation(fields: [listId], references: [id])
  createdBy   User  @relation("WorkItemCreator", fields: [createdById], references: [id])
  submittedBy User? @relation("WorkItemSubmitter", fields: [submittedById], references: [id])
  approvedBy  User? @relation("WorkItemApprover", fields: [approvedById], references: [id])

  labels        WorkItemLabel[]
  members       WorkItemMember[]
  divisionIds   WorkItemDivision[]
  mirrorBoards  WorkItemMirror[]
  activities    Activity[]
  comments      Comment[]
  notifications Notification[]
  attachments   Attachment[]

  masterCard          MasterCard?                 @relation(fields: [masterCardId], references: [id])
  sourceUser          User?                       @relation("WorkItemSource", fields: [sourceUserId], references: [id])
  sourceBoard         Board?                      @relation("SourceBoard", fields: [sourceBoardId], references: [id])
  sourceList          List?                       @relation("SourceList", fields: [sourceListId], references: [id])
  targetDivision      Division?                   @relation("TargetDivision", fields: [targetDivisionId], references: [id])
  targetBoard         Board?                      @relation("TargetBoard", fields: [targetBoardId], references: [id])
  targetList          List?                       @relation("TargetList", fields: [targetListId], references: [id])
  currentPic          User?                       @relation("CurrentPic", fields: [currentPicId], references: [id])
  assignmentHistories WorkItemAssignmentHistory[]

  @@index([masterCardId])
  @@index([targetDivisionId, distributionStatus])
}

model WorkItemLabel {
  workItemId String
  labelId    String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  label      Label    @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([workItemId, labelId])
}

model WorkItemMember {
  workItemId String
  userId     String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workItemId, userId])
}

model WorkItemDivision {
  workItemId String
  divisionId String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  @@id([workItemId, divisionId])
}

model WorkItemMirror {
  workItemId String
  boardId    String
  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  board      Board    @relation(fields: [boardId], references: [id], onDelete: Cascade)

  @@id([workItemId, boardId])
}

model Comment {
  id            String   @id @default(uuid())
  workItemId    String
  createdById   String
  createdByName String
  text          String   @db.Text
  attachmentId  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workItemId])
}

model Activity {
  id         String   @id @default(uuid())
  workItemId String
  boardId    String?
  userId     String
  userName   String?
  action     String
  detail     Json?
  createdAt  DateTime @default(now())

  workItem WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  board    Board?   @relation(fields: [boardId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])
}

model Notification {
  id         String   @id @default(uuid())
  userId     String
  type       String
  title      String
  body       String
  workItemId String?
  boardId    String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workItem WorkItem? @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  board    Board?    @relation(fields: [boardId], references: [id], onDelete: Cascade)
}

model AutomationRule {
  id            String   @id @default(uuid())
  boardId       String
  trigger       String
  triggerListId String?
  action        String
  actionValue   String?
  createdById   String
  createdAt     DateTime @default(now())

  board       Board @relation(fields: [boardId], references: [id], onDelete: Cascade)
  triggerList List? @relation(fields: [triggerListId], references: [id], onDelete: Cascade)
}

model Attachment {
  id               String   @id @default(uuid())
  workItemId       String
  storagePath      String
  originalFilename String
  contentType      String
  size             Int
  uploadedById     String
  uploadedByName   String?
  isDeleted        Boolean  @default(false)
  createdAt        DateTime @default(now())

  workItem   WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])
}

model LoginAttempt {
  identifier String   @id
  count      Int      @default(0)
  lastAt     DateTime @default(now())
}

model CronRun {
  runId String   @id
  at    DateTime @default(now())
  job   String
}

model Setting {
  key   String   @id
  value Json?
  at    DateTime @default(now())
}

// ── Permission matrix (role × aksi) yang bisa diatur admin ───────────────
// Katalog aksi (AppPermission) sebagian dikurasi manual, sebagian di-generate
// otomatis dari setiap model Prisma ("table.<Model>") lewat syncPermissions().
model AppPermission {
  key       String   @id // mis. "bankdata.send_to_division" atau "table.User"
  label     String
  category  String
  kind      String   @default("feature") // "feature" | "table"
  createdAt DateTime @default(now())

  roles RolePermission[]
}

model RolePermission {
  id      String  @id @default(uuid())
  role    String
  permKey String
  allowed Boolean @default(false)

  permission AppPermission @relation(fields: [permKey], references: [key], onDelete: Cascade)

  @@unique([role, permKey])
  @@index([role])
}

// Template checklist yang dikelola admin di Panel Admin. Dipakai user saat
// menambah checklist pada kartu (isi item disalin, bukan direferensikan).
model ChecklistTemplate {
  id          String   @id @default(uuid())
  name        String
  items       Json     @default("[]") // string[]
  position    Float    @default(0)
  // Kalau true: CS boleh anggap "semua item tercentang = lengkap" dan langsung
  // FU klien sendiri tanpa nunggu Admin verifikasi (lihat catatan di
  // routes_work.ts checklist creation — item "Diverifikasi Admin" tidak
  // ditambahkan otomatis untuk template dengan flag ini).
  csSelfCheck Boolean  @default(false)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WorkItemAssignmentHistory {
  id          String           @id @default(uuid())
  workItemId  String
  fromUserId  String?
  toUserId    String?
  action      AssignmentAction
  reason      String?          @db.Text
  createdById String
  createdAt   DateTime         @default(now())

  workItem  WorkItem @relation(fields: [workItemId], references: [id], onDelete: Cascade)
  fromUser  User?    @relation("AssignmentFrom", fields: [fromUserId], references: [id])
  toUser    User?    @relation("AssignmentTo", fields: [toUserId], references: [id])
  createdBy User     @relation("AssignmentCreated", fields: [createdById], references: [id])
}
